{
  "name": "orbitaldc-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based interactive 3D physics simulator of a space data center",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy_pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "baseline": "tsx scripts/baseline.ts",
    "docs:params": "tsx scripts/gen_params_doc.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.177.0",
    "uplot": "^1.6.32",
    "zod": "^3.25.67",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.177.0",
    "@vitejs/plugin-react": "^4.5.2",
    "puppeteer-core": "^25.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
